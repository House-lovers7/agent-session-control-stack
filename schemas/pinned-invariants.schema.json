{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/House-lovers7/agent-session-control-stack/schemas/pinned-invariants.schema.json",
  "title": "ASCS Pinned Invariants",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "authority",
    "recovery",
    "protected_invariants"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_may_expand_authority",
        "state_may_grant_approval",
        "current_approval_required_for"
      ],
      "properties": {
        "state_may_expand_authority": {
          "const": false
        },
        "state_may_grant_approval": {
          "const": false
        },
        "current_approval_required_for": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 6,
          "items": {
            "enum": [
              "external_send",
              "expensive_api",
              "production_change",
              "confidential_data",
              "destructive_or_irreversible",
              "tool_capability_escalation"
            ]
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_fresh_source_check",
        "require_fresh_verification",
        "on_repository_mismatch",
        "on_uncommitted_invariant_change"
      ],
      "properties": {
        "require_fresh_source_check": {
          "const": true
        },
        "require_fresh_verification": {
          "const": true
        },
        "on_repository_mismatch": {
          "const": "REJECT"
        },
        "on_uncommitted_invariant_change": {
          "const": "REVERIFY"
        }
      }
    },
    "protected_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "statement"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
